#!/bin/sh
# NONAME-KIT managed privacy hook
repo=$(git rev-parse --show-toplevel) || exit 2
node_bin=$(git config --get nonamekit.privacyNode)
[ -n "$node_bin" ] || node_bin=node
checker=$(git config --get nonamekit.privacyChecker)
[ -n "$checker" ] || checker="$repo/scripts/privacy-check.mjs"
exec "$node_bin" "$checker" --staged
